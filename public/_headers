# Encabezados de seguridad para Cloudflare Pages (sitio estático, sin funciones).
# Cualquier cambio debe probarse con `npm run test:e2e`, que los aplica localmente.
#
# Content-Security-Policy:
#   script-src 'self'          sólo los módulos compilados; no hay scripts en línea.
#   style-src 'unsafe-inline'  React, Recharts y KaTeX usan atributos de estilo.
#   img-src data: blob:        vista previa SVG (data:) y conversión a PNG (blob:).
#   connect-src 'self'         precarga de módulos del mismo origen.
# Las descargas usan enlaces blob: y no requieren permisos adicionales.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
